# ============================================================
# TERRAVITA
# MODULE 01: BAYAD TALUKA AOI VERIFICATION
# AI-DRIVEN AGRICULTURAL DIGITAL TWIN
# ============================================================

# Install:
# pip install geopandas shapely pyproj rasterio matplotlib pandas earthengine-api geemap

import os
import json
import warnings
import geopandas as gpd
import pandas as pd
import matplotlib.pyplot as plt
import ee

from shapely.geometry import Polygon, MultiPolygon
from shapely.validation import explain_validity

warnings.filterwarnings("ignore")

# ============================================================
# 01. PROJECT CONFIGURATION
# ============================================================

PROJECT = "TERRAVITA_BAYAD"

RAW_DIR = os.path.join(PROJECT, "01_RAW_DATA")
OUTPUT_DIR = os.path.join(PROJECT, "01_OUTPUTS")

os.makedirs(OUTPUT_DIR, exist_ok=True)

SOURCE_BOUNDARY_PATH = os.path.join(
    RAW_DIR,
    "Village_Boundaries",
    "Aravalli_Villages.gpkg"
)

NAME_COL = "Vill_name"
DISTRICT_COL = "District"

TARGET_CRS = "EPSG:32643"
OUTPUT_CRS = "EPSG:4326"

EE_PROJECT = "terraworks-511519"

# ============================================================
# 02. GAZETTE VILLAGE LIST
# INSERT THE AUDITED SCHEDULE A VILLAGE NAMES
# INCLUDE GABAT AS PER THE SUBSEQUENT AMENDMENT
# ============================================================

BAYAD_GAZETTE = [
    # "Village Name 1",
    # "Village Name 2",
    # "Gabat",
]

if not BAYAD_GAZETTE:
    raise ValueError(
        "Insert the verified Gazette village list before running."
    )

# ============================================================
# 03. LOAD VILLAGE BOUNDARIES
# ============================================================

if not os.path.exists(SOURCE_BOUNDARY_PATH):
    raise FileNotFoundError(SOURCE_BOUNDARY_PATH)

villages = gpd.read_file(SOURCE_BOUNDARY_PATH)

print("Source features:", len(villages))
print("Source CRS:", villages.crs)
print("Source columns:", villages.columns.tolist())

if villages.crs is None:
    raise ValueError("Source boundary CRS is missing.")

if NAME_COL not in villages.columns:
    raise ValueError(f"Missing village-name column: {NAME_COL}")

# ============================================================
# 04. NORMALIZE VILLAGE NAMES
# ============================================================

def normalize_name(value):
    if pd.isna(value):
        return ""

    return (
        str(value)
        .strip()
        .upper()
        .replace(" ", "")
        .replace("-", "")
        .replace("_", "")
        .replace(".", "")
    )

villages["_norm_name"] = villages[NAME_COL].apply(
    normalize_name
)

gazette_normalized = {
    normalize_name(name): name
    for name in BAYAD_GAZETTE
}

if len(gazette_normalized) != len(BAYAD_GAZETTE):
    raise ValueError(
        "Duplicate village names found after normalization."
    )

# ============================================================
# 05. MATCH GAZETTE VILLAGES
# ============================================================

available_names = set(villages["_norm_name"])

matched_names = {
    name: gazette_normalized[name]
    for name in gazette_normalized
    if name in available_names
}

unmatched_names = [
    original
    for normalized, original in gazette_normalized.items()
    if normalized not in available_names
]

print("Gazette village count:", len(BAYAD_GAZETTE))
print("Matched villages:", len(matched_names))
print("Unmatched villages:", len(unmatched_names))

if unmatched_names:
    print("\nUNMATCHED VILLAGES:")
    for name in unmatched_names:
        print("-", name)

    raise ValueError(
        "Resolve all unmatched village names before proceeding."
    )

# ============================================================
# 06. SELECT BAYAD VILLAGE POLYGONS
# ============================================================

selected = villages[
    villages["_norm_name"].isin(matched_names.keys())
].copy()

if selected.empty:
    raise ValueError("No village polygons matched.")

if selected["_norm_name"].nunique() != len(BAYAD_GAZETTE):
    raise ValueError(
        "Matched unique village count does not equal Gazette count."
    )

print("Selected polygon count:", len(selected))
print(
    "Unique matched villages:",
    selected["_norm_name"].nunique()
)

# ============================================================
# 07. GEOMETRY VALIDATION
# ============================================================

selected = selected[
    selected.geometry.notna()
    & ~selected.geometry.is_empty
].copy()

selected["geometry"] = selected.geometry.make_valid()

print("Invalid geometries remaining:",
      (~selected.geometry.is_valid).sum())

selected = selected[
    selected.geometry.geom_type.isin(
        ["Polygon", "MultiPolygon"]
    )
].copy()

# ============================================================
# 08. REPROJECT TO UTM
# ============================================================

selected_utm = selected.to_crs(TARGET_CRS)

# ============================================================
# 09. DISSOLVE VILLAGE POLYGONS
# ============================================================

bayad = selected_utm.dissolve()

bayad = bayad.reset_index(drop=True)

bayad["NAME"] = "Bayad Taluka"

bayad["ADMIN_VERSION"] = (
    "2025 Gazette + subsequent Gabat amendment"
)

bayad["SOURCE"] = (
    "Survey of India village boundary polygons"
)

bayad["VILLAGE_COUNT"] = len(BAYAD_GAZETTE)

# ============================================================
# 10. AREA CALCULATION
# ============================================================

bayad["AREA_SQ_KM"] = (
    bayad.geometry.area / 1_000_000
)

area_sq_km = float(bayad["AREA_SQ_KM"].iloc[0])

print("Bayad area (sq. km):", round(area_sq_km, 3))

# ============================================================
# 11. CONNECTED COMPONENT CHECK
# ============================================================

geometry = bayad.geometry.iloc[0]

if geometry.geom_type == "Polygon":
    component_count = 1

elif geometry.geom_type == "MultiPolygon":
    component_count = len(geometry.geoms)

else:
    raise ValueError(
        f"Unexpected geometry: {geometry.geom_type}"
    )

print("Connected polygon components:", component_count)

# ============================================================
# 12. AREA ACCOUNTING
# ============================================================

selected_area = selected_utm.geometry.area.sum()

dissolved_area = bayad.geometry.area.sum()

overlap_difference = (
    selected_area - dissolved_area
) / 1_000_000

print(
    "Selected polygon area (sq. km):",
    round(selected_area / 1_000_000, 3)
)

print(
    "Dissolved area (sq. km):",
    round(dissolved_area / 1_000_000, 3)
)

print(
    "Area difference (sq. km):",
    round(overlap_difference, 3)
)

# ============================================================
# 13. EXPORT GEOJSON
# ============================================================

bayad_wgs84 = bayad.to_crs(OUTPUT_CRS)

geojson_path = os.path.join(
    OUTPUT_DIR,
    "Bayad_Taluka_2025.geojson"
)

bayad_wgs84.to_file(
    geojson_path,
    driver="GeoJSON"
)

# ============================================================
# 14. EXPORT GEOPACKAGE
# ============================================================

gpkg_path = os.path.join(
    OUTPUT_DIR,
    "Bayad_Taluka_2025.gpkg"
)

bayad.to_file(
    gpkg_path,
    layer="Bayad_Taluka_2025",
    driver="GPKG"
)

# ============================================================
# 15. EXPORT SHAPEFILE
# ============================================================

shp_path = os.path.join(
    OUTPUT_DIR,
    "Bayad_Taluka_2025.shp"
)

bayad_wgs84.to_file(
    shp_path,
    driver="ESRI Shapefile"
)

# ============================================================
# 16. CREATE 5 KM BUFFER
# ============================================================

buffer_5km = bayad.copy()

buffer_5km["geometry"] = (
    buffer_5km.geometry.buffer(5000)
)

buffer_path = os.path.join(
    OUTPUT_DIR,
    "Bayad_5km_Buffer.gpkg"
)

buffer_5km.to_file(
    buffer_path,
    layer="Bayad_5km_Buffer",
    driver="GPKG"
)

# ============================================================
# 17. CREATE STUDY AREA MAP
# ============================================================

fig, ax = plt.subplots(figsize=(10, 10))

buffer_5km.boundary.plot(
    ax=ax,
    color="grey",
    linewidth=1,
    linestyle="--"
)

bayad.boundary.plot(
    ax=ax,
    color="darkgreen",
    linewidth=1.5
)

bayad.plot(
    ax=ax,
    color="lightgreen",
    alpha=0.35
)

ax.set_title(
    "Bayad Taluka – Administrative Study Area",
    fontsize=14
)

ax.set_axis_off()

plt.tight_layout()

map_path = os.path.join(
    OUTPUT_DIR,
    "Bayad_Taluka_Study_Area.png"
)

plt.savefig(
    map_path,
    dpi=300,
    bbox_inches="tight"
)

plt.show()

# ============================================================
# 18. SAVE QA REPORT
# ============================================================

qa_report = {
    "project": "TerraVita Bayad Agricultural Digital Twin",
    "study_area": "Bayad Taluka, Aravalli, Gujarat, India",
    "administrative_version": (
        "2025 Gazette + subsequent Gabat amendment"
    ),
    "gazette_village_count": len(BAYAD_GAZETTE),
    "matched_village_count": len(matched_names),
    "unmatched_villages": unmatched_names,
    "source_polygon_count": len(selected),
    "connected_components": component_count,
    "area_sq_km": round(area_sq_km, 3),
    "target_crs": TARGET_CRS,
    "output_crs": OUTPUT_CRS,
    "geometry_valid": bool(bayad.geometry.is_valid.all()),
    "source": "Survey of India village boundary polygons"
}

qa_path = os.path.join(
    OUTPUT_DIR,
    "Bayad_AOI_QA_Report.json"
)

with open(qa_path, "w") as file:
    json.dump(qa_report, file, indent=4)

print("\nMODULE 01 COMPLETED")
print("Outputs saved to:", OUTPUT_DIR)

for filename in os.listdir(OUTPUT_DIR):
    print(filename)

# ============================================================
# 19. GOOGLE EARTH ENGINE AUTHENTICATION
# ============================================================

try:
    ee.Initialize(project=EE_PROJECT)
    print("Earth Engine initialized.")

except Exception:
    ee.Authenticate()
    ee.Initialize(project=EE_PROJECT)
    print("Earth Engine authenticated and initialized.")

# ============================================================
# 20. LOAD AOI INTO EARTH ENGINE
# ============================================================

import geemap

bayad_ee = geemap.geopandas_to_ee(
    bayad_wgs84
)

print(
    "Earth Engine feature count:",
    bayad_ee.size().getInfo()
)

print(
    "Earth Engine area (sq. km):",
    round(
        bayad_ee.geometry().area(1).divide(1e6).getInfo(),
        3
    )
)

print(
    "Earth Engine geometry type:",
    bayad_ee.geometry().type().getInfo()
)

# ============================================================
# 21. FINAL VERIFICATION
# ============================================================

print("\n========== FINAL AOI VERIFICATION ==========")

print("Feature count:", len(bayad))
print("Area (sq. km):", round(area_sq_km, 3))
print("Components:", component_count)
print("Matched villages:", len(matched_names))
print("Valid geometry:", bayad.geometry.is_valid.all())

print("\nReview the Gazette-to-village mapping and component")
print("count before treating this boundary as authoritative.")
